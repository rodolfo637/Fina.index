<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="theme-color" content="#101827"><meta name="description" content="Mis Gastos: asistente personal para organizar ingresos, gastos, ahorro e inversiones.">
<title>Mis Gastos · Finanzas personales</title>
<style>
:root{color-scheme:dark;--bg:#0b1220;--panel:#131e30;--panel2:#1a2940;--text:#edf3fb;--muted:#9aabc1;--line:#293951;--accent:#62d6b1;--red:#ff7d87;--blue:#80aaff;--gold:#f2c66d;--shadow:0 14px 38px #0003}
*{box-sizing:border-box}body{margin:0;background:radial-gradient(ellipse at 20% -10%,#1d3851 0,transparent 42%),var(--bg);color:var(--text);font:15px/1.5 system-ui,-apple-system,Segoe UI,Roboto,sans-serif}button,input,select{font:inherit}button{cursor:pointer}.wrap{max-width:1120px;margin:auto;padding:22px 18px 100px}.top{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:24px}.brand{display:flex;gap:12px;align-items:center}.logo{width:43px;height:43px;border-radius:14px;background:linear-gradient(145deg,#6ce0bb,#3e9fba);display:grid;place-items:center;color:#08221d;font-size:22px;font-weight:900}.brand h1{font-size:20px;margin:0}.sub,.muted{color:var(--muted);font-size:13px}.actions{display:flex;gap:8px}.btn,.tab{border:1px solid var(--line);border-radius:12px;background:var(--panel2);color:var(--text);padding:10px 13px}.btn.primary{background:var(--accent);color:#08251e;border-color:transparent;font-weight:750}.btn.danger{color:var(--red)}.tabs{display:flex;gap:7px;overflow:auto;padding:4px 0 15px}.tab{white-space:nowrap;padding:9px 14px}.tab.active{background:var(--accent);color:#08251e;border-color:transparent;font-weight:750}.grid{display:grid;grid-template-columns:repeat(12,1fr);gap:14px}.card{background:linear-gradient(145deg,var(--panel),#111b2b);border:1px solid var(--line);border-radius:18px;padding:18px;box-shadow:var(--shadow);min-width:0}.span3{grid-column:span 3}.span4{grid-column:span 4}.span5{grid-column:span 5}.span6{grid-column:span 6}.span7{grid-column:span 7}.span8{grid-column:span 8}.span12{grid-column:span 12}.kpi-label{font-size:13px;color:var(--muted)}.kpi{font-size:clamp(21px,3vw,29px);font-weight:800;letter-spacing:-.7px;margin-top:5px;overflow-wrap:anywhere}.positive{color:var(--accent)}.negative{color:var(--red)}h2{font-size:17px;margin:0 0 14px}h3{font-size:14px;margin:0 0 8px;color:var(--muted)}.monthbar{display:flex;align-items:center;gap:12px;margin-bottom:15px}.monthbar strong{min-width:135px;text-align:center}.monthbar button{background:transparent;color:var(--text);border:1px solid var(--line);border-radius:9px;padding:5px 11px}.field{display:flex;flex-direction:column;gap:5px;margin-bottom:11px}.field label{font-size:12px;color:var(--muted)}.field input,.field select,.search{background:#0c1626;border:1px solid var(--line);border-radius:10px;color:var(--text);padding:11px;width:100%;min-width:0}.row{display:flex;gap:9px;align-items:center}.row>*{flex:1}.formgrid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:0 12px}.barline{display:flex;align-items:center;gap:10px;margin:12px 0}.barname{width:110px;font-size:13px;color:var(--muted)}.track{height:9px;background:#26364c;border-radius:20px;overflow:hidden;flex:1}.fill{height:100%;background:var(--accent);border-radius:20px}.barvalue{width:95px;text-align:right;font-size:12px}.item{display:flex;justify-content:space-between;align-items:center;gap:12px;padding:12px 0;border-bottom:1px solid var(--line)}.item:last-child{border:0}.item small{display:block;color:var(--muted)}.pill{font-size:11px;padding:4px 8px;border-radius:20px;background:#263b50;color:#b9d5e8}.empty{padding:24px;text-align:center;color:var(--muted)}.hidden{display:none!important}.voice{display:flex;gap:8px}.voice input{flex:1}.voice button{border-radius:12px;border:0;background:#274c50;color:#a9ffe2;padding:0 15px}.notice{border:1px solid #665332;background:#322b20;color:#f4d99c;border-radius:12px;padding:12px;font-size:13px}.foot{color:var(--muted);font-size:12px;text-align:center;margin-top:24px}.fab{position:fixed;right:22px;bottom:22px;width:58px;height:58px;border:0;border-radius:20px;background:var(--accent);color:#09251e;font-size:30px;box-shadow:var(--shadow)}.modalback{position:fixed;inset:0;background:#0009;display:grid;place-items:center;padding:16px;z-index:5}.modal{width:min(520px,100%);max-height:90vh;overflow:auto;background:var(--panel);border:1px solid var(--line);border-radius:18px;padding:20px;box-shadow:var(--shadow)}.modalhead{display:flex;justify-content:space-between;align-items:center;margin-bottom:15px}.modalhead h2{margin:0}.close{background:none;border:0;color:var(--text);font-size:24px}.actions .btn{padding:8px 10px}
@media(max-width:760px){.span3,.span4,.span5,.span6,.span7,.span8{grid-column:span 12}.wrap{padding:16px 13px 95px}.top{align-items:flex-start}.brand h1{font-size:18px}.actions .btn{font-size:12px;padding:8px}.kpi{font-size:25px}.barname{width:85px}}
</style></head>
<body><main class="wrap">
<header class="top"><div class="brand"><div class="logo">$</div><div><h1>Mis Gastos</h1><div class="sub">Tu asistente financiero personal</div></div></div><div class="actions"><button class="btn" id="themeBtn" title="Cambiar apariencia">◐</button><button class="btn" id="backupBtn">Respaldo</button></div></header>
<nav class="tabs" aria-label="Secciones"><button class="tab active" data-tab="inicio">Inicio</button><button class="tab" data-tab="movimientos">Movimientos</button><button class="tab" data-tab="presupuesto">50 / 30 / 20</button><button class="tab" data-tab="ajustes">Ajustes</button></nav>
<section id="inicio" class="page"><div class="monthbar"><button id="prevMonth">‹</button><strong id="monthLabel"></strong><button id="nextMonth">›</button><span class="muted" id="monthHint"></span></div>
<div class="grid"><article class="card span3"><div class="kpi-label">Ingresos del mes</div><div class="kpi positive" id="incomeKpi">$ 0</div></article><article class="card span3"><div class="kpi-label">Gastos del mes</div><div class="kpi negative" id="expenseKpi">$ 0</div></article><article class="card span3"><div class="kpi-label">Balance del mes</div><div class="kpi" id="balanceKpi">$ 0</div></article><article class="card span3"><div class="kpi-label">Ahorro registrado</div><div class="kpi" id="savingKpi">$ 0</div></article>
<article class="card span7"><h2>Registrar con tus palabras</h2><div class="voice"><input id="quickText" placeholder="Ej.: gasté 15 mil en supermercado"><button id="voiceBtn" title="Dictar por voz">🎙</button></div><div class="sub" style="margin-top:8px">Probá: “gasté 8500 en nafta”, “cobré 500000 sueldo”. Revisá el registro antes de guardarlo.</div><div id="quickPreview" class="sub" style="margin-top:8px"></div></article>
<article class="card span5"><h2>Distribución de gastos</h2><div id="categoryBars"></div></article>
<article class="card span6"><h2>Últimos movimientos</h2><div id="recentList"></div></article><article class="card span6"><h2>Resumen de tu dinero</h2><div id="moneySummary"></div></article></div></section>
<section id="movimientos" class="page hidden"><div class="card"><div class="row" style="margin-bottom:12px"><input class="search" id="searchInput" placeholder="Buscar por descripción o categoría"><select id="typeFilter" class="search"><option value="todos">Todos</option><option value="gasto">Gastos</option><option value="ingreso">Ingresos</option><option value="ahorro">Ahorro</option><option value="inversion">Inversiones</option></select></div><div id="allList"></div></div></section>
<section id="presupuesto" class="page hidden"><div class="grid"><article class="card span6"><h2>Regla 50 / 30 / 20</h2><p class="muted">Una guía orientativa: 50% necesidades, 30% deseos y 20% ahorro. Ajustala a tu realidad.</p><div class="field"><label>Ingreso mensual neto ($)</label><input type="number" id="budgetIncome" min="0" placeholder="Ej. 800000"></div><div id="budgetResult"></div><button class="btn primary" id="saveBudget">Guardar ingreso</button></article><article class="card span6"><h2>Calculadora de interés compuesto</h2><div class="field"><label>Capital inicial ($)</label><input type="number" id="principal" value="100000"></div><div class="field"><label>Aporte mensual ($)</label><input type="number" id="contribution" value="20000"></div><div class="field"><label>Tasa anual estimada (%)</label><input type="number" id="rate" value="30" step=".1"></div><div class="field"><label>Plazo (años)</label><input type="number" id="years" value="5" min="1" max="60"></div><div class="kpi positive" id="compoundResult">$ 0</div><div class="sub">Simulación matemática, no representa una rentabilidad garantizada ni descuenta inflación, impuestos o comisiones.</div></article><article class="card span12"><h2>Consejo de lectura</h2><p class="muted">Compará tus gastos reales con los porcentajes sugeridos. Si tus gastos esenciales superan el 50%, no significa que estés haciendo algo mal: usá la regla como referencia flexible.</p></article></div></section>
<section id="ajustes" class="page hidden"><div class="grid"><article class="card span6"><h2>Preferencias</h2><div class="field"><label>Cotización de referencia: 1 USD equivale a ($)</label><input type="number" id="usdRate" min="0" step=".01"></div><div class="field"><label>Moneda principal</label><select id="currency"><option value="ARS">Pesos argentinos (ARS)</option><option value="USD">Dólares (USD)</option></select></div><button class="btn primary" id="saveSettings">Guardar preferencias</button><p class="sub">La cotización es manual y orientativa; no se consulta automáticamente al mercado.</p></article><article class="card span6"><h2>Tus datos</h2><p class="muted">Los movimientos se guardan en el almacenamiento local de este navegador, en este dispositivo.</p><div class="row"><button class="btn" id="exportCsv">Exportar CSV</button><button class="btn" id="importBtn">Importar respaldo</button><input type="file" id="importFile" accept="application/json" hidden></div><p style="margin-top:15px"><button class="btn danger" id="clearData">Borrar todos los movimientos</button></p><div class="notice">Importante: exportá un respaldo periódicamente. Si borrás los datos del navegador o cambiás de dispositivo, podés perder la información que no hayas respaldado.</div></article></div></section>
<div class="foot">Tus datos permanecen en este dispositivo · Mis Gastos</div></main>
<button class="fab" id="addBtn" aria-label="Agregar movimiento">+</button>
<div class="modalback hidden" id="modal"><div class="modal"><div class="modalhead"><h2 id="modalTitle">Nuevo movimiento</h2><button class="close" id="closeModal">×</button></div><form id="movementForm"><input type="hidden" id="editId"><div class="formgrid"><div class="field"><label>Tipo</label><select id="mType"><option value="gasto">Gasto</option><option value="ingreso">Ingreso</option><option value="ahorro">Ahorro</option><option value="inversion">Inversión</option></select></div><div class="field"><label>Importe ($)</label><input type="number" id="mAmount" min=".01" step=".01" required placeholder="0"></div><div class="field"><label>Descripción</label><input id="mDescription" required placeholder="Ej. Compra supermercado"></div><div class="field"><label>Categoría</label><select id="mCategory"><option>Alimentación</option><option>Vivienda</option><option>Transporte</option><option>Salud</option><option>Servicios</option><option>Educación</option><option>Ocio</option><option>Sueldo</option><option>Otros</option></select></div><div class="field"><label>Fecha</label><input type="date" id="mDate" required></div><div class="field"><label>Nota (opcional)</label><input id="mNote" placeholder="Detalle adicional"></div></div><div class="row"><button type="button" class="btn" id="cancelModal">Cancelar</button><button class="btn primary" type="submit">Guardar movimiento</button></div></form></div></div>
<script>
(()=>{'use strict';
const $=id=>document.getElementById(id), KEY='misGastosApp_v1';
const today=()=>new Date().toISOString().slice(0,10);
let data={transactions:[],settings:{currency:'ARS',usdRate:1000,budgetIncome:0},dark:true}, viewDate=new Date(), quickDraft=null;
const money=n=>new Intl.NumberFormat('es-AR',{style:'currency',currency:'ARS',maximumFractionDigits:0}).format(Number(n)||0);
const load=()=>{try{const saved=JSON.parse(localStorage.getItem(KEY));if(saved&&Array.isArray(saved.transactions))data={...data,...saved,settings:{...data.settings,...saved.settings}}}catch(e){console.warn('No se pudo leer el respaldo local',e)}};
const persist=()=>{try{localStorage.setItem(KEY,JSON.stringify(data));return true}catch(e){alert('No se pudieron guardar los datos. Revisá el espacio disponible del navegador.');return false}};
const monthKey=d=>d.getFullYear()+'-'+String(d.getMonth()+1).padStart(2,'0');
const monthItems=()=>data.transactions.filter(t=>t.date?.slice(0,7)===monthKey(viewDate));
const sum=(arr,type)=>arr.filter(t=>t.type===type).reduce((s,t)=>s+Number(t.amount),0);
const escapeHtml=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
function render(){const items=monthItems(),inc=sum(items,'ingreso'),exp=sum(items,'gasto'),sav=sum(items,'ahorro'),inv=sum(items,'inversion');
$('monthLabel').textContent=new Intl.DateTimeFormat('es-AR',{month:'long',year:'numeric'}).format(viewDate);
$('incomeKpi').textContent=money(inc);$('expenseKpi').textContent=money(exp);$('balanceKpi').textContent=money(inc-exp-sav-inv);$('balanceKpi').className='kpi '+(inc-exp-sav-inv>=0?'positive':'negative');$('savingKpi').textContent=money(sav+inv);
const cats={};items.filter(t=>t.type==='gasto').forEach(t=>cats[t.category]=(cats[t.category]||0)+Number(t.amount));
const entries=Object.entries(cats).sort((a,b)=>b[1]-a[1]);$('categoryBars').innerHTML=entries.length?entries.map(([k,v])=>'<div class="barline"><span class="barname">'+escapeHtml(k)+'</span><div class="track"><div class="fill" style="width:'+Math.max(2,v/Math.max(exp,1)*100)+'%"></div></div><span class="barvalue">'+money(v)+'</span></div>').join():'<div class="empty">Todavía no hay gastos este mes.</div>';
const recent=[...items].sort((a,b)=>b.date.localeCompare(a.date)).slice(0,5);$('recentList').innerHTML=recent.length?recent.map(t=>itemHTML(t,false)).join(''):'<div class="empty">Agregá tu primer movimiento con el botón +.</div>';
$('moneySummary').innerHTML='<div class="item"><span>Disponible después de gastos y ahorro</span><strong>'+money(inc-exp-sav-inv)+'</strong></div><div class="item"><span>Inversiones</span><strong>'+money(inv)+'</strong></div><div class="item"><span>Movimientos registrados</span><strong>'+items.length+'</strong></div>';
renderAll();renderBudget();calcCompound();
}
function itemHTML(t,actions=true){const sign=t.type==='ingreso'?'+':'−',cl=t.type==='ingreso'?'positive':t.type==='gasto'?'negative':'';
return '<div class="item"><div><strong>'+escapeHtml(t.description)+'</strong><small>'+escapeHtml(t.category)+' · '+escapeHtml(t.date)+' · '+escapeHtml(t.type)+'</small></div><div style="text-align:right"><strong class="'+cl+'">'+sign+money(t.amount)+'</strong>'+(actions?'<div><button class="btn" data-edit="'+t.id+'" style="padding:4px 7px;font-size:11px">Editar</button> <button class="btn danger" data-delete="'+t.id+'" style="padding:4px 7px;font-size:11px">×</button></div>':'')+'</div></div>'}
function renderAll(){const q=$('searchInput').value.toLowerCase(),type=$('typeFilter').value;const list=[...data.transactions].filter(t=>(type==='todos'||t.type===type)&&[t.description,t.category,t.note].join(' ').toLowerCase().includes(q)).sort((a,b)=>b.date.localeCompare(a.date));$('allList').innerHTML=list.length?list.map(t=>itemHTML(t,true)).join(''):'<div class="empty">No hay movimientos que coincidan.</div>'}
function openModal(t=null){$('modal').classList.remove('hidden');$('modalTitle').textContent=t?'Editar movimiento':'Nuevo movimiento';$('editId').value=t?.id||'';$('mType').value=t?.type||'gasto';$('mAmount').value=t?.amount||'';$('mDescription').value=t?.description||'';$('mCategory').value=t?.category||'Otros';$('mDate').value=t?.date||today();$('mNote').value=t?.note||''}
function closeModal(){$('modal').classList.add('hidden')}
$('movementForm').addEventListener('submit',e=>{e.preventDefault();const id=$('editId').value;const t={id:id||String(Date.now()),type:$('mType').value,amount:Number($('mAmount').value),description:$('mDescription').value.trim(),category:$('mCategory').value,date:$('mDate').value,note:$('mNote').value.trim()};if(!t.description||!t.date||!Number.isFinite(t.amount)||t.amount<=0)return alert('Completá una descripción, fecha e importe válido.');if(id)data.transactions=data.transactions.map(x=>x.id===id?t:x);else data.transactions.push(t);persist();closeModal();render()});
$('addBtn').onclick=()=>openModal();$('closeModal').onclick=closeModal;$('cancelModal').onclick=closeModal;$('modal').addEventListener('click',e=>{if(e.target===$('modal'))closeModal()});
document.addEventListener('click',e=>{const ed=e.target.closest('[data-edit]'),del=e.target.closest('[data-delete]');if(ed){const t=data.transactions.find(x=>x.id===ed.dataset.edit);if(t)openModal(t)}if(del&&confirm('¿Eliminar este movimiento?')){data.transactions=data.transactions.filter(x=>x.id!==del.dataset.delete);persist();render()}});
document.querySelectorAll('[data-tab]').forEach(b=>b.onclick=()=>{document.querySelectorAll('[data-tab]').forEach(x=>x.classList.toggle('active',x===b));document.querySelectorAll('.page').forEach(x=>x.classList.toggle('hidden',x.id!==b.dataset.tab));if(b.dataset.tab==='movimientos')renderAll()});
$('prevMonth').onclick=()=>{viewDate.setMonth(viewDate.getMonth()-1);render()};$('nextMonth').onclick=()=>{viewDate.setMonth(viewDate.getMonth()+1);render()};
$('searchInput').oninput=renderAll;$('typeFilter').onchange=renderAll;
function parseQuick(text){const s=text.toLowerCase().trim();const match=s.match(/(?:\$\s*)?([0-9][0-9.,]*)\s*(mil|k|millon(?:es)?|millón(?:es)?)?/i);if(!match)return null;let amount=Number(match[1].replace(/\./g,'').replace(',','.'));if(!Number.isFinite(amount))return null;if(match[2])amount*=/mil|k/i.test(match[2])?1000:1000000;let type=/cobr[eé]|ingres[oó]|sueldo|me pagaron|recib[ií]/i.test(s)?'ingreso':/ahorr[eé]|ahorro/i.test(s)?'ahorro':/invert[ií]|inversi[oó]n/i.test(s)?'inversion':'gasto';let category='Otros';for(const [re,c] of [[/super|almac[eé]n|comida|verdura|carne|panader/i,'Alimentación'],[/nafta|colectivo|taxi|uber|transporte/i,'Transporte'],[/alquiler|casa|expensas/i,'Vivienda'],[/luz|agua|gas|internet|tel[eé]fono/i,'Servicios'],[/farmacia|m[eé]dico|salud/i,'Salud'],[/facultad|libro|estudio/i,'Educación'],[/sueldo|salario/i,'Sueldo']])if(re.test(s)){category=c;break}
let description=s.replace(/^(gast[eé]|compr[eé]|pagu[eé]|cobr[eé]|recib[ií]|ahorr[eé]|invert[ií])\s*/i,'').replace(match[0],'').trim()||category;
return {type,amount,category,description:description.charAt(0).toUpperCase()+description.slice(1),date:today()}}
$('quickText').addEventListener('input',()=>{quickDraft=parseQuick($('quickText').value);$('quickPreview').innerHTML=quickDraft?'Detecté: <strong>'+escapeHtml(quickDraft.type)+'</strong> · '+money(quickDraft.amount)+' · '+escapeHtml(quickDraft.category)+' · <button class="btn primary" id="confirmQuick" style="padding:5px 9px">Confirmar</button>':'Escribí un importe, por ejemplo: gasté 8500 en nafta.'});
$('quickPreview').addEventListener('click',e=>{if(e.target.id==='confirmQuick'&&quickDraft){openModal(quickDraft);$('quickText').value='';$('quickPreview').textContent='';quickDraft=null}});
$('voiceBtn').onclick=()=>{const SR=window.SpeechRecognition||window.webkitSpeechRecognition;if(!SR){alert('El dictado por voz no está disponible en este navegador. Podés escribir el movimiento.');return}const rec=new SR();rec.lang='es-AR';rec.onresult=e=>{$('quickText').value=e.results[0][0].transcript;$('quickText').dispatchEvent(new Event('input'))};rec.onerror=()=>alert('No se pudo reconocer la voz. Revisá el permiso del micrófono.');rec.start()};
function renderBudget(){const n=Number(data.settings.budgetIncome)||0;$('budgetIncome').value=n||'';const parts=[['Necesidades',50],['Deseos',30],['Ahorro',20]];$('budgetResult').innerHTML=parts.map(([k,p])=>'<div class="item"><span>'+k+' · '+p+'%</span><strong>'+money(n*p/100)+'</strong></div>').join('')}
$('saveBudget').onclick=()=>{data.settings.budgetIncome=Math.max(0,Number($('budgetIncome').value)||0);persist();renderBudget()};
function calcCompound(){const p=Math.max(0,Number($('principal').value)||0),c=Math.max(0,Number($('contribution').value)||0),r=(Number($('rate').value)||0)/1200,n=Math.min(720,Math.max(1,(Number($('years').value)||1)*12));let total=p;for(let i=0;i<n;i++)total=total*(1+r)+c;$('compoundResult').textContent=money(total)}
['principal','contribution','rate','years'].forEach(id=>$(id).addEventListener('input',calcCompound));
$('saveSettings').onclick=()=>{data.settings.usdRate=Math.max(0,Number($('usdRate').value)||0);data.settings.currency=$('currency').value;persist();alert('Preferencias guardadas.')};
function exportJSON(){const blob=new Blob([JSON.stringify({...data,exportedAt:new Date().toISOString()},null,2)],{type:'application/json'});download(blob,'mis-gastos-respaldo.json')}
function download(blob,name){const a=document.createElement('a');const url=URL.createObjectURL(blob);a.href=url;a.download=name;a.click();URL.revokeObjectURL(url)}
$('backupBtn').onclick=exportJSON;$('importBtn').onclick=()=>$('importFile').click();
$('importFile').onchange=async e=>{const f=e.target.files[0];if(!f)return;try{const obj=JSON.parse(await f.text());if(!obj||!Array.isArray(obj.transactions))throw Error('Formato incorrecto');if(!confirm('La importación reemplazará los movimientos actuales. ¿Continuar?'))return;data={...data,...obj,settings:{...data.settings,...obj.settings}};persist();render();alert('Respaldo importado.')}catch(err){alert('No se pudo importar: '+err.message)}e.target.value=''};
$('exportCsv').onclick=()=>{const rows=[['Fecha','Tipo','Descripción','Categoría','Importe','Nota'],...data.transactions.map(t=>[t.date,t.type,t.description,t.category,t.amount,t.note||''])];const csv=rows.map(r=>r.map(v=>'"'+String(v).replace(/"/g,'""')+'"').join(';')).join('\r\n');download(new Blob(['\ufeff'+csv],{type:'text/csv;charset=utf-8'}),'mis-gastos.csv')};
$('clearData').onclick=()=>{if(confirm('¿Seguro que querés borrar TODOS los movimientos de este dispositivo? Esta acción no se puede deshacer.')){data.transactions=[];persist();render()}};
$('themeBtn').onclick=()=>{document.body.classList.toggle('light');const light=document.body.classList.contains('light');document.documentElement.style.colorScheme=light?'light':'dark';document.documentElement.style.setProperty('--bg',light?'#edf2f7':'#0b1220');document.documentElement.style.setProperty('--panel',light?'#fff':'#131e30');document.documentElement.style.setProperty('--panel2',light?'#e4ebf3':'#1a2940');document.documentElement.style.setProperty('--text',light?'#182435':'#edf3fb');document.documentElement.style.setProperty('--muted',light?'#5e6d80':'#9aabc1');document.documentElement.style.setProperty('--line',light?'#d4deea':'#293951')};
load();$('usdRate').value=data.settings.usdRate||1000;$('currency').value=data.settings.currency||'ARS';render();
})();
</script></body></html>